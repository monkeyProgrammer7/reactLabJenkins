{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:coverage": "vitest run --project=unit --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reportOnFailure",
    "test:chrome": "vitest run --project=chromium",
    "test:firefox": "vitest run --project=firefox"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.0.0",
    "playwright": "1.63.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
