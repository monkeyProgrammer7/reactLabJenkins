pipeline {
    agent any

    parameters {
        string(name: 'REPO_URL', defaultValue: 'https://github.com/USUARIO/REPO.git', description: 'URL del repositorio de GitHub')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Rama a clonar')
    }

    environment {
        // Hace que los tests se ejecuten una sola vez (sin modo watch)
        CI = 'true'
    }

    stages {
        stage('Clonar repositorio') {
            steps {
                git url: params.REPO_URL, branch: params.BRANCH
            }
        }

        stage('Instalar dependencias') {
            steps {
                sh 'node --version && npm --version'
                sh 'npm install'
            }
        }

        stage('Tests') {
            steps {
                sh 'npm test'
            }
        }
    }
}
