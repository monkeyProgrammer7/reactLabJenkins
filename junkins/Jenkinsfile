pipeline {
    agent any

    tools {
        nodejs 'Node_24' // Nombre definido en Global Tool Configuration
    }

    stages {
        // Etapa 1: Checkout del código desde GitHub
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/monkeyProgrammer7/reactLabJenkins.git'
            }
        }

        // Etapa 2: Instalar dependencias y build del proyecto
        stage('Build') {
            steps {
                // La app React está en la carpeta frontend/ del repositorio
                dir('frontend') {
                    sh 'npm install'
                    sh 'npm run build' // Ejecuta el build de React
                }
            }
        }

        // Etapa 3: Ejecutar pruebas unitarias
        stage('Pruebas Unitarias') {
            steps {
                dir('frontend') {
                    // vitest run: salida normal en consola + reporte JUnit en junit.xml
                    sh 'NO_COLOR=1 npm test -- --reporter=default --reporter=junit --outputFile.junit=junit.xml'
                }
            }
            post {
                always {
                    junit 'frontend/junit.xml' // Publica reporte en Jenkins
                    archiveArtifacts artifacts: 'frontend/junit.xml', allowEmptyArchive: true
                }
            }
        }
    }

    // Post-actions (opcional)
    post {
        success {
            echo '¡Pipeline ejecutado con éxito!'
        }
        failure {
            echo 'Pipeline fallido. Revisar logs.'
        }
    }
}
